{
  "name": "@rogerchappel/agentpermit",
  "version": "0.1.0",
  "description": "Local policy simulator for agent tool permissions.",
  "type": "module",
  "bin": {
    "agentpermit": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "examples",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "CODE_OF_CONDUCT.md",
    "ROADMAP.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "dev": "tsx src/cli.ts",
    "smoke": "npm run build && bash -c 'node dist/cli.js check fixtures/mixed --format text; test $? -eq 1' && node dist/cli.js check fixtures/clean --format json",
    "package:smoke": "bash scripts/package-smoke.sh",
    "docs:check": "node scripts/check-publication-docs.mjs",
    "release:check": "npm test && npm run check && npm run docs:check && npm run build && npm run smoke && npm run package:smoke",
    "prepack": "npm run build",
    "lint": "npm run check"
  },
  "keywords": [
    "agents",
    "cli",
    "policy",
    "permissions",
    "sandbox",
    "security",
    "simulator"
  ],
  "author": "Roger Chappel",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.23.12",
    "typescript": "^5.7.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rogerchappel/agentpermit.git"
  },
  "homepage": "https://github.com/rogerchappel/agentpermit#readme",
  "bugs": {
    "url": "https://github.com/rogerchappel/agentpermit/issues"
  }
}
